{
  "name": "@satsuma/integration-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-consumer parity sweeps: CLI, viz-backend and the LSP's shared model must agree about one workspace",
  "type": "module",
  "scripts": {
    "test": "node --import tsx/esm --import ./test/setup.ts --test 'test/**/*.test.ts'",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --import tsx/esm --import ./test/setup.ts --test 'test/**/*.test.ts'",
    "test:typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@satsuma/core": "*",
    "@satsuma/scenario-gen": "*",
    "@satsuma/viz-backend": "*",
    "@types/node": "^25.5.0",
    "c8": "^11.0.0",
    "fast-check": "^4.9.0",
    "satsuma-cli": "*",
    "tree-sitter-satsuma": "*",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  }
}
