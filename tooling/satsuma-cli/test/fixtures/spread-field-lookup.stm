// Fixture for bsw-ep0m: fields that reach a schema only through fragment
// spreads, at every depth a field-scoped command must see through.
//
// src.created_by        top-level spread (audit)
// src.orders.created_by spread inside a record, transitively (line -> audit)
// src.orders.qty        spread inside a record (line)
// src.ship.addr.city    a fragment's own record that spreads another (shipping -> geo)
// src.inner.created_by  a fragment's record spreads a fragment the schema also
//                       spreads beside it (audit, envelope -> audit): not a cycle
// namesakes.city        a top-level field and a nested field share a name

fragment audit {
  created_by  STRING  (note "who created it")
}

fragment line {
  ...audit
  qty  INT  (note "units ordered")
}

fragment geo {
  city  STRING  (note "delivery city")
}

fragment envelope {
  inner record {
    ...audit
  }
}

fragment shipping {
  addr record {
    ...geo
  }
}

schema src {
  ...audit
  ...envelope
  orders list_of record {
    ...line
    oid  STRING
  }
  ship record {
    ...shipping
  }
}

schema tgt {
  who   STRING
  city  STRING
  inner_who  STRING
  rows list_of record {
    a  STRING
    c  INT
    d  STRING
  }
}

mapping m {
  source { src }
  target { tgt }

  created_by -> who
  ship.addr.city -> city
  inner.created_by -> inner_who
  each orders -> rows {
    .created_by -> .a
    .qty -> .c
    .oid -> .d
  }
}

schema namesakes {
  city  STRING  (note "top city")
  addr record {
    city  STRING  (note "addr city")
  }
}
