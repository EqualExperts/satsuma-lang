// Fixture for ccc-3vaw: an empty record body is structure that carries no data.
//
// `record {}` and `list_of record {}` are legal Satsuma (spec §5.1) and declare
// no children, so nothing beneath them marks them as containers. Coverage read
// them as leaves: `tgt` reported 2/5 40% with `records {covered: 0, partial: 1,
// uncovered: 0}` — a denominator inflated by two fields that cannot hold data,
// and a tally missing two of the three records declared.
//
// It now reports 2/3 66% with `records {covered: 0, partial: 1, uncovered: 2}`,
// which sums to the three declared containers.

schema src {
  a  STRING
}

schema tgt {
  a  STRING
  hollow record {
  }
  hollow_list list_of record {
  }
  filled record {
    x  STRING
    y  STRING
  }
}

mapping `load` {
  source { `src` }
  target { `tgt` }

  a -> a
  a -> filled.x
}
