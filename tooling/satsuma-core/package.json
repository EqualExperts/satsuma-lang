{
  "name": "@satsuma/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Satsuma core utilities",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./cst-utils": {
      "types": "./dist/cst-utils.d.ts",
      "default": "./dist/cst-utils.js"
    },
    "./classify": {
      "types": "./dist/classify.d.ts",
      "default": "./dist/classify.js"
    },
    "./canonical-ref": {
      "types": "./dist/canonical-ref.d.ts",
      "default": "./dist/canonical-ref.js"
    },
    "./meta-extract": {
      "types": "./dist/meta-extract.d.ts",
      "default": "./dist/meta-extract.js"
    },
    "./extract": {
      "types": "./dist/extract.d.ts",
      "default": "./dist/extract.js"
    },
    "./spread-expand": {
      "types": "./dist/spread-expand.d.ts",
      "default": "./dist/spread-expand.js"
    },
    "./nl-ref": {
      "types": "./dist/nl-ref.d.ts",
      "default": "./dist/nl-ref.js"
    },
    "./string-utils": {
      "types": "./dist/string-utils.d.ts",
      "default": "./dist/string-utils.js"
    },
    "./source-files": {
      "types": "./dist/source-files.d.ts",
      "default": "./dist/source-files.js"
    },
    "./reference-stages": {
      "types": "./dist/reference-stages.d.ts",
      "default": "./dist/reference-stages.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    },
    "./parse-errors": {
      "types": "./dist/parse-errors.d.ts",
      "default": "./dist/parse-errors.js"
    },
    "./coverage": {
      "types": "./dist/coverage.d.ts",
      "default": "./dist/coverage.js"
    },
    "./coverage-paths": {
      "types": "./dist/coverage-paths.d.ts",
      "default": "./dist/coverage-paths.js"
    },
    "./coverage-rollup": {
      "types": "./dist/coverage-rollup.d.ts",
      "default": "./dist/coverage-rollup.js"
    },
    "./config": {
      "types": "./dist/satsuma-config.d.ts",
      "default": "./dist/satsuma-config.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --test test/**/*.test.js",
    "test:typecheck": "tsc --project tsconfig.type-tests.json",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=json-summary --include='dist/**/*.js' --exclude='dist/**/*.d.ts' node --test test/**/*.test.js"
  },
  "dependencies": {
    "web-tree-sitter": "^0.26.11",
    "yaml": "^2.9.0"
  },
  "//devDependencies": [
    "tree-sitter-satsuma is not imported anywhere in this package. It is declared",
    "because every parser-backed test suite here loads the grammar WASM it builds,",
    "and because that package's `generate` step writes this package's",
    "src/generated/cst-types.ts. Declaring the edge is what lets Turborepo derive",
    "the build order from the manifests instead of it being special-cased in",
    "turbo.json (feature 42, R4)."
  ],
  "devDependencies": {
    "@satsuma/scenario-gen": "*",
    "@types/node": "^26.2.0",
    "c8": "^12.0.0",
    "fast-check": "^4.9.0",
    "tree-sitter-satsuma": "*",
    "typescript": "^6.0.3"
  }
}
