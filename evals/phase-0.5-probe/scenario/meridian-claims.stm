// Satsuma v2 — Meridian Mutual Insurance Claims (Phase 0.5 probe scenario)
//
// Hand-authored for Feature 44's Phase 0.5 probe. Not part of examples/ —
// deliberately uses a domain absent from the corpus (contamination control,
// PRD §Training-data contamination). Do not run the canary probe from this
// file; it lives under evals/ precisely so it is not confused for a real spec.

import { fx_rates } from "../lookups/claims_fx.stm"

note {
  """
  # Meridian Mutual — Claims Normalisation

  Maps inbound claim intake into an analytics-ready fact, with per-vehicle
  and per-party dimension extracts and a downstream status snapshot.

  **Source system:** the claims management system's nightly export.
  **Target:** the `analytics.claims` schema (Snowflake).
  """
}

// --- Sources ---

schema claim_header (note "Inbound claim intake from the claims management system") {
  claim_id      VARCHAR(20)   (pk, required)
  policy_no     VARCHAR(30)   (required)
  claim_type    VARCHAR(15)   (required)
  reported_at   TIMESTAMPTZ   (required)
  incident_at   TIMESTAMPTZ
  loss_amount   DECIMAL(14,2)
  currency      CHAR(3)       (default USD)
  adjuster_id   VARCHAR(20)
  status        VARCHAR(20)   (required)

  vehicles list_of record {
    vin            VARCHAR(17)   (required)
    make           VARCHAR(40)
    model          VARCHAR(40)
    year           INT
    damage_extent  VARCHAR(15)   (enum {none, minor, moderate, severe, total, scratch})
    estimate       DECIMAL(12,2)

    photos list_of record {
      photo_id  VARCHAR(36) (required)
      angle     VARCHAR(10) (enum {front, rear, left, right, interior})
    }
  }

  parties list_of record {
    party_role    VARCHAR(20)  (required)
    name          VARCHAR(120)
    contact_phone VARCHAR(20)  (pii)
  }
}

schema policy_dim (note "Policy master record (lookup target)") {
  policy_no        VARCHAR(30)  (pk, required)
  product_code     VARCHAR(10)  (required)
  policyholder_id  VARCHAR(20)  (required)
  effective_date   DATE
  expiry_date      DATE
  territory        VARCHAR(10)
}

// --- Targets ---

schema claim_fact (note "Analytics-ready claim fact (target of the main mapping)") {
  claim_key        VARCHAR(20)   (pk)
  policy_ref       VARCHAR(30)   (indexed)
  claim_type_code  VARCHAR(2)
  reported_date    TIMESTAMP_NTZ
  loss_usd         DECIMAL(14,2) (required)
  loss_source      VARCHAR(10)
  vehicle_count    INT
  party_count      INT
  max_damage       VARCHAR(15)

  photos list_of record {
    photo_ref  VARCHAR(36) (required)
    view       VARCHAR(10)
  }

  adjuster_ref     VARCHAR(20)
  is_open          BOOLEAN
}

schema party_dim (note "One row per party on a claim") {
  claim_key  VARCHAR(20) (required)
  rows list_of record {
    role          VARCHAR(20)   (required)
    display_name  VARCHAR(120)
    phone_e164    VARCHAR(20)
  }
}

schema vehicle_dim (note "One row per vehicle on a claim") {
  claim_key  VARCHAR(20) (required)
  rows list_of record {
    vin           VARCHAR(17)   (required)
    description   VARCHAR(100)
    damage_class  VARCHAR(15)
    estimate_usd  DECIMAL(12,2)
  }
}

schema claim_status_snapshot (note "Downstream summary — exercises multi-hop lineage for T4") {
  claim_key       VARCHAR(20)   (pk, ref claim_fact.claim_key)
  open_flag       BOOLEAN
  total_exposure  DECIMAL(14,2)
}

schema payment_fact (note "One row per claim payment — downstream of claim_fact for T4") {
  payment_id   VARCHAR(36)  (pk)
  claim_key    VARCHAR(20)   (ref claim_fact.claim_key)
  paid_amount  DECIMAL(14,2)
  paid_at      TIMESTAMP_NTZ
}

schema fraud_flag (note "Downstream fraud indicator — longest T4 chain") {
  claim_key     VARCHAR(20)  (pk, ref claim_fact.claim_key)
  risk_score    INT
  is_flagged    BOOLEAN
}

// --- Mappings ---

mapping claim_normalisation {
  source { claim_header, policy_dim, fx_rates }
  target { claim_fact }

  claim_id -> claim_key
  policy_no -> policy_ref

  claim_type -> claim_type_code {
    map {
      auto: AU
      home: HO
      life: LI
      health: HE
    }
  }

  reported_at -> reported_date { to_utc }

  loss_amount -> loss_usd {
    "Convert to USD using @fx_rates lookup on @claim_header.currency, then round"
    | round 2
  }

  loss_amount -> loss_source { coalesce 0 }

  vehicles -> vehicle_count { count }
  parties -> party_count { count }

  vehicles.damage_extent -> max_damage {
    "Pick the worst damage across all vehicles on the claim"
  }

  flatten vehicles.photos -> photos {
    .photo_id -> .photo_ref { trim }
    .angle -> .view { lowercase }
  }

  adjuster_id -> adjuster_ref { trim }

  -> is_open {
    "True if @claim_header.status is 'open' or 'under_review', false otherwise."
  }
}

mapping party_extract {
  source { claim_header }
  target { party_dim }

  claim_id -> claim_key

  each parties -> .rows {
    .party_role -> .role { trim | uppercase }
    .name -> .display_name { trim }
    .contact_phone -> .phone_e164 {
      "Format to E.164, assuming US country code if no + prefix"
    }
  }
}

mapping vehicle_extract {
  source { claim_header }
  target { vehicle_dim }

  claim_id -> claim_key

  each vehicles -> .rows {
    .vin -> .vin { uppercase }
    .make -> .description {
      "@vehicles.make || ' ' || @vehicles.model || ' ' || @vehicles.year"
    }
    .damage_extent -> .damage_class {
      map {
        none: N
        minor: M
        moderate: M
        severe: S
        total: T
      }
    }
    .estimate -> .estimate_usd { round 2 }
  }
}

mapping status_snapshot {
  source { claim_fact }
  target { claim_status_snapshot }

  claim_key -> claim_key
  is_open -> open_flag
  loss_usd -> total_exposure {
    "Sum exposure across all open claims for the same policy"
  }
}

mapping payment_extract {
  source { claim_fact }
  target { payment_fact }

  claim_key -> claim_key
  loss_usd -> paid_amount { round 2 }
  reported_date -> paid_at { to_utc }
}

mapping fraud_assessment {
  source { claim_fact, party_dim }
  target { fraud_flag }

  claim_key -> claim_key
  party_count -> risk_score { multiply 10 }
  party_count -> is_flagged {
    "True if @party_count > 7, false otherwise."
  }
}
