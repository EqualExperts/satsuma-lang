.cache
.tree-sitter

# Turborepo's local content-hash cache and per-task log files. Local only —
# no remote cache is configured (ADR-049).
.turbo/

# JUnit XML that CI uploads as an artifact. Written inside the owning package
# since feature 42's R5, so Turborepo can declare it as a task output — a path
# at the repo root cannot be one, and an undeclared output means a cache hit
# restores no XML for the upload step to find.
test-results/
.DS_Store
log.html
__pycache__/
**/node_modules
**/dist
**/generated
!tooling/satsuma-core/src/generated/
!tooling/satsuma-core/src/generated/cst-types.ts
**/coverage

# TypeScript build artifacts that may leak into src/ directories
**/*.js.map
tooling/satsuma-cli/src/**/*.js
tooling/satsuma-cli/src/**/*.d.ts
site/_site/
site/satsuma-diaries/
site/playground/
.worktrees/
.claude/worktrees/
.claude/*.local.md
.claude/*.local.json
.claude/settings.local.json

**/*.vsix
**/*.wasm
**/*.log
**/*.zip
**/*.tar.gz
**/*.tgz
**/*.bak
**/*.tmp
**/*.swp
**/.vscode
**/.idea
**/.vscode-test
**/.vscode-test-insiders
**/.vscode-test-explorer
**/.vscode-test-insiders-explorer
**/.vscode-test-explorer-insiders       

# Python virtualenv for repo lint tools (ruff, yamllint) — see run-repo-checks.sh
.venv/

tmp/
